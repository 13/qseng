{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "qseng",
    "Audience": "qseng",
    "//Key": "Development placeholder. Startup fails outside Development unless Jwt__Key is overridden.",
    "Key": "change-me-in-prod-please-32+chars-long-key!",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14
  },
  "Uploads": {
    "Path": "uploads"
  },
  "Trash": {
    "RetentionDays": 30
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  }
}
