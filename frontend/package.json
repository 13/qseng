{
  "name": "frontend",
  "version": "0.0.0",
  "//": "postinstall runs the i18n key and OpenAPI client generators; CI must install devDependencies (npm ci without --omit=dev). src/app/core/api/generated/ is not committed.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "gen:i18n": "node scripts/gen-i18n-keys.mjs",
    "gen:api": "ng-openapi-gen --config ng-openapi-gen.json",
    "gen": "npm run gen:i18n && npm run gen:api",
    "prestart": "npm run gen",
    "prebuild": "npm run gen",
    "pretest": "npm run gen",
    "postinstall": "npm run gen",
    "lint": "ng lint",
    "gates": "node scripts/check-gates.mjs",
    "e2e:lint": "eslint e2e --config eslint.config.js",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:ui": "playwright test -c e2e/playwright.config.ts --ui",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/animations": "^21.2.10",
    "@angular/cdk": "~21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "~21.2.14",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@types/dagre": "^0.7.54",
    "cytoscape": "^3.33.2",
    "cytoscape-dagre": "^2.5.0",
    "dagre": "^0.8.5",
    "material-symbols": "^0.47.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.8",
    "@angular/cli": "^21.2.8",
    "@angular/compiler-cli": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/cytoscape": "^3.21.9",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "21.4.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.3.0",
    "jsdom": "^29.1.1",
    "ng-openapi-gen": "^1.0.5",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.59.2",
    "vitest": "^4.1.10"
  }
}
