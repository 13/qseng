# Build
# frontend/'s postinstall (npm ci) runs generators that need the full frontend/ tree (scripts/,
# public/assets/i18n/) and ng-openapi-gen.json's "../contracts/openapi.json", so contracts/ is
# copied as a sibling of frontend/ here rather than frontend/ alone before npm ci.
FROM node:22-alpine AS build
WORKDIR /repo
COPY contracts/ contracts/
COPY frontend/ frontend/
WORKDIR /repo/frontend
RUN npm ci
RUN npm run build -- --configuration=production

# Serve
FROM nginx:1.27-alpine AS runtime
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/frontend/dist/frontend/browser /usr/share/nginx/html
EXPOSE 80
